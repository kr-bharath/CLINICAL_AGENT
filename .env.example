# Get a free Groq key (no credit card): https://console.groq.com/keys
GROQ_API_KEY=

# Optional fallback provider. Get a free Google AI Studio key:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides — current free-tier models as of Sept 2026.
# Groq retired llama-3.1-8b-instant / llama-3.3-70b-versatile on 2026-08-16.
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-2.5-flash

# Set to "1" to force every module into mock mode (no network calls at all).
CLINICAL_AGENT_MOCK=
